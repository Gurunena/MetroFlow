{
  "info": {
    "name": "MetroFlow API",
    "_postman_id": "metroflow-api-collection",
    "description": "Every MetroFlow endpoint.\n\n1. Set {{baseUrl}} (default http://localhost:3000).\n2. Run 'Admin login' once - it stores the JWT in {{token}}.\n3. Admin-only calls send Authorization: Bearer {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin login (saves {{token}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin-login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "admin-login"
              ]
            },
            "description": "Run this first. The test script stores the JWT in {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Email\": \"admin@metroflow.lk\",\n  \"Password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "    pm.test('token saved', function () {",
                  "        pm.expect(body.data.token).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register passenger",
          "request": {
